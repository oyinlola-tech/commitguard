# CommitGuard environment variables.
#
# The CLI (scan, check, install, the Git hooks, `ci github`) needs NONE of
# these: no credentials, no network and no database. Copy this file only if you
# run the GitHub App service (`commitguard github serve`).
#
# Never commit a real .env file. Prefer the *_FILE variants below: they keep the
# secret out of the process environment, where `ps`, crash dumps and child
# processes can read it.
#
# Full reference: docs/github-app.md (App), docs/notifications.md
# (notifications), docs/deployment/self-hosted.md (deployment).

# --- GitHub App identity (required by `commitguard github serve`) -----------
# COMMITGUARD_GITHUB_APP_ID=
# COMMITGUARD_GITHUB_PRIVATE_KEY_FILE=/etc/commitguard/private-key.pem
# COMMITGUARD_GITHUB_PRIVATE_KEY=
# COMMITGUARD_GITHUB_WEBHOOK_SECRET_FILE=/etc/commitguard/webhook-secret
# COMMITGUARD_GITHUB_WEBHOOK_SECRET=

# --- App state (required) ---------------------------------------------------
# Absolute path; created with mode 0700. Holds the SQLite database and mirrors.
# COMMITGUARD_APP_DATA_DIR=/var/lib/commitguard

# --- App behaviour (optional) -----------------------------------------------
# COMMITGUARD_APP_MANDATORY_POLICY_FILE=
# COMMITGUARD_APP_WORKERS=2
# COMMITGUARD_APP_RETENTION_DAYS=30
# COMMITGUARD_APP_MAX_COMMITS=10000
# COMMITGUARD_ENV=production

# --- Dashboard (optional; sign-in needs a GitHub OAuth client) --------------
# COMMITGUARD_DASHBOARD_URL=
# COMMITGUARD_DASHBOARD_STATIC_DIR=
# COMMITGUARD_DASHBOARD_ALLOWED_ORIGINS=
# COMMITGUARD_GITHUB_CLIENT_ID=
# COMMITGUARD_GITHUB_CLIENT_SECRET_FILE=
# COMMITGUARD_GITHUB_CLIENT_SECRET=

# --- Notifications (optional) -----------------------------------------------
# COMMITGUARD_NOTIFICATIONS_MODE=
# COMMITGUARD_NOTIFICATION_SIGNING_KEY_FILE=
# COMMITGUARD_NOTIFICATION_SIGNING_KEY=
# COMMITGUARD_NOTIFICATION_RETENTION_DAYS=
# COMMITGUARD_SMTP_HOST=
# COMMITGUARD_SMTP_PORT=
# COMMITGUARD_SMTP_SECURITY=
# COMMITGUARD_SMTP_FROM=
# COMMITGUARD_SMTP_USERNAME=
# COMMITGUARD_SMTP_PASSWORD_FILE=
# COMMITGUARD_SMTP_PASSWORD=

# --- Reproducibility and research (optional; see docs/research/) ------------
# COMMITGUARD_EVIDENCE_DIR=
# COMMITGUARD_CHECK_CONTEXTS=
