# Runtime dependencies of CommitGuard plus the build backend, for installing
# CommitGuard in CI with `pip install --require-hashes` and
# `--no-build-isolation` (no unhashed downloads).
#
# Regenerate requirements/ci.txt after changing this file or pyproject.toml:
#   pip-compile --generate-hashes --allow-unsafe --strip-extras \
#     --output-file requirements/ci.txt requirements/ci.in
